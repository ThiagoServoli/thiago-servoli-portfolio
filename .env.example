# Copie este arquivo para ".env" e preencha os valores necessários.
# Nenhum segredo real deve ser commitado no repositório.

# URL pública do site (usada em metadata, Open Graph e JSON-LD)
NEXT_PUBLIC_SITE_URL=https://thiagoservoli.vercel.app

# Formulário de contato (src/app/api/contact/route.ts): cópia opcional por e-mail via Resend (resend.com).
# Sem nenhum canal (WhatsApp ou e-mail) configurado, o formulário avisa e
# oferece o envio direto pelo WhatsApp.
RESEND_API_KEY=
CONTACT_TO=
# Opcional: remetente de um domínio verificado no Resend (padrão: onboarding@resend.dev)
CONTACT_FROM=

# reCAPTCHA v3 (https://www.google.com/recaptcha/admin): crie um site do tipo "v3"
# e adicione os domínios (thiagoservoli.vercel.app e localhost).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# WhatsApp pessoal via CallMeBot (gratuito): adicione o número do bot aos contatos,
# envie "I allow callmebot to send me messages" e receba a API key no próprio WhatsApp.
# Passo a passo: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_APIKEY=
# Número que recebe (só dígitos, com DDI). Padrão: o de src/data/profile.ts
WHATSAPP_PHONE=5511981118056
